<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <Button android:id="@+id/hcode_back" style="@style/QuietButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/home_hcode_title" android:textColor="@color/ink" android:textSize="18sp" android:fontFamily="sans-serif-medium" />
        <Button android:id="@+id/hcode_reload" style="@style/QuietButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hcode_reload" />
        <Button android:id="@+id/hcode_settings" style="@style/QuietButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hcode_address" />
    </LinearLayout>
    <WebView android:id="@+id/hcode_webview" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
