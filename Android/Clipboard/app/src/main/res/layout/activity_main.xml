<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="12dp">
        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:padding="5dp" android:background="@drawable/bg_soft" android:src="@drawable/ic_clip" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="@string/app_name" android:textSize="24sp" android:letterSpacing="-0.02" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" />
        <Button android:id="@+id/cloud" style="@style/QuietButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/cloud_entry" android:contentDescription="@string/cloud_title" />
        <ImageButton android:id="@+id/add" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="12dp" android:padding="12dp" android:background="@drawable/bg_add" android:src="@drawable/ic_add" android:contentDescription="@string/add_description" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:background="@drawable/bg_search" android:paddingStart="14dp" android:paddingEnd="0dp">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_search" android:importantForAccessibility="no" />
        <EditText android:id="@+id/search" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@null" android:paddingHorizontal="10dp" android:singleLine="true" android:inputType="text" android:imeOptions="actionSearch" android:hint="@string/search_hint" android:textColor="@color/ink" android:textColorHint="@color/muted" android:textSize="15sp" android:autofillHints="" />
        <Button android:id="@+id/clear_search" style="@style/QuietButton" android:layout_width="48dp" android:layout_height="match_parent" android:text="@string/clear_symbol" android:textSize="22sp" android:contentDescription="@string/clear_search" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="8dp" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sort_hint" android:textSize="12sp" android:textColor="@color/muted" />
        <TextView android:id="@+id/count" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textSize="12sp" android:textColor="@color/muted" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="8dp" android:listSelector="@android:color/transparent" android:clipToPadding="false" android:paddingBottom="8dp" android:scrollbars="none" />
        <LinearLayout android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:paddingBottom="48dp">
            <ImageView android:layout_width="88dp" android:layout_height="88dp" android:background="@drawable/bg_soft" android:padding="24dp" android:src="@drawable/ic_clip" android:importantForAccessibility="no" />
            <TextView android:id="@+id/empty_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center" android:text="@string/empty_title" android:textColor="@color/ink" android:textSize="19sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/empty_message" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="@string/empty_message" android:textColor="@color/muted" android:textSize="14sp" android:lineSpacingExtra="6dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
